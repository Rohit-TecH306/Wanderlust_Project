<%layout("/layouts/boilerplate")%>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>
                <%= listing.title %>
            </h3>
        </div>
        <div class="card col-6 offset-3 show-card listing-card">
            <% if (listing.image && listing.image.url) { %>
                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>">
            <% } else { %>
                <div class="card-img-top show-img listing-image-fallback" role="img" aria-label="No image available for <%= listing.title %>">
                    No image available
                </div>
            <% } %>
            <div class="card-body">
                <h5 class="card-title"></h5>

                <p class="card-text">
                    <% if (listing.owner && listing.owner.username) { %>
                        Owned By <%= listing.owner.username %>
                            <% } else { %>
                                Owned By Unknown
                                <% } %>
                </p>
                <p class="card-text">
                    <%=listing.description%>
                </p>
                <p class="card-text">&#8377;<%=listing.price.toLocaleString("en-IN")%></p>
                <p class="card-text">Up to <%= listing.maxGuests || 1 %> guest<%= (listing.maxGuests || 1) === 1 ? "" : "s" %></p>
                <p class="card-text">
                    <%=listing.location%><br>
                </p>
                <p class="card-text">
                    <%=listing.country%>
                </p>
            </div>
        </div>
                <% if(currentUser && listing.owner && listing.owner._id && listing.owner._id.equals(currentUser._id))
                    {%>
                    <div class="btns">
                        <a href="/listings/<%= listing._id %>/edit"
                            class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>

                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button type="submit" class="btn btn-dark offset-5">
                                Delete
                            </button>
                        </form>
                    </div>
                    <% } %>

                        <div class="col-8 offset-3 mb-3 ">
                            <hr>
                            <% if (!currentUser) { %>
                                <h4>Request to book</h4>
                                <p>Please <a href="/login">log in</a> to request this stay.</p>
                            <% } else if (listing.owner && listing.owner._id && listing.owner._id.equals(currentUser._id)) { %>
                                <h4>Request to book</h4>
                                <p class="text-muted">You cannot book your own listing.</p>
                            <% } else { %>
                                <section class="booking-request-panel">
                                    <header class="booking-request-header">
                                        <div>
                                            <p class="booking-request-kicker">Stay request</p>
                                            <h4>Request to book</h4>
                                        </div>
                                        <div class="booking-request-price">
                                            <strong>₹<%= listing.price.toLocaleString("en-IN") %></strong>
                                            <span>/ night</span>
                                        </div>
                                    </header>
                                    <p class="booking-request-capacity"><i class="fa-solid fa-user-group" aria-hidden="true"></i>Maximum <%= listing.maxGuests || 1 %> guest<%= (listing.maxGuests || 1) === 1 ? "" : "s" %></p>
                                <form action="/listings/<%= listing._id %>/bookings" method="POST" class="needs-validation" data-booking-form data-preview-url="/listings/<%= listing._id %>/bookings/preview" novalidate>
                                    <div class="row">
                                        <div class="mb-3 col-md-6">
                                            <label for="checkIn" class="form-label booking-field-label">Check-in</label>
                                            <input type="date" id="checkIn" name="booking[checkIn]" class="form-control booking-date-input" required>
                                            <div class="invalid-feedback">Choose a check-in date.</div>
                                        </div>
                                        <div class="mb-3 col-md-6">
                                            <label for="checkOut" class="form-label booking-field-label">Check-out</label>
                                            <input type="date" id="checkOut" name="booking[checkOut]" class="form-control booking-date-input" required>
                                            <div class="invalid-feedback">Choose a check-out date.</div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="bookingGuests" class="form-label booking-field-label">Guests</label>
                                        <input type="number" id="bookingGuests" name="booking[guests]" class="form-control booking-guest-input" min="1" max="<%= listing.maxGuests || 1 %>" step="1" value="1" required>
                                        <div class="form-text">Maximum <%= listing.maxGuests || 1 %> guest<%= (listing.maxGuests || 1) === 1 ? "" : "s" %>.</div>
                                        <div class="invalid-feedback">Enter a valid number of guests.</div>
                                    </div>
                                    <section id="bookingPreview" class="booking-summary booking-summary-idle" role="status" aria-live="polite">
                                        <div class="booking-summary-header">
                                            <span id="bookingPreviewIcon" class="booking-summary-icon" aria-hidden="true"><i class="fa-regular fa-calendar"></i></span>
                                            <div>
                                                <p class="booking-summary-title">Booking Summary</p>
                                                <p id="bookingPreviewMessage" class="booking-summary-message">Select your check-in and check-out dates to see availability and estimated total.</p>
                                            </div>
                                        </div>
                                        <div id="bookingPreviewDetails" class="booking-summary-details" hidden>
                                            <div class="booking-summary-availability"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Available</div>
                                            <div class="booking-summary-main">
                                                <strong id="bookingPreviewNights"></strong>
                                                <span id="bookingPreviewBreakdown"></span>
                                            </div>
                                            <div class="booking-summary-total">
                                                <span>Estimated total</span>
                                                <strong id="bookingPreviewTotal"></strong>
                                            </div>
                                        </div>
                                    </section>
                                    <div class="mb-3">
                                        <label for="guestMessage" class="form-label booking-field-label">Message for the host</label>
                                        <p id="guestMessageHelp" class="booking-message-help">Optional - tell the host anything they should know.</p>
                                        <textarea id="guestMessage" name="booking[guestMessage]" class="form-control booking-message-input" maxlength="500" rows="3" aria-describedby="guestMessageHelp"></textarea>
                                    </div>
                                    <button type="submit" class="btn booking-submit-button" data-booking-submit>
                                        <i class="fa-regular fa-calendar-check" data-booking-submit-icon aria-hidden="true"></i>
                                        <span data-booking-submit-label>Send Booking Request</span>
                                    </button>
                                </form>
                                <script>
                                    const bookingForm = document.querySelector("[data-booking-form]");
                                    const bookingPreview = document.getElementById("bookingPreview");
                                    const bookingPreviewIcon = document.getElementById("bookingPreviewIcon");
                                    const bookingPreviewMessage = document.getElementById("bookingPreviewMessage");
                                    const bookingPreviewDetails = document.getElementById("bookingPreviewDetails");
                                    const bookingPreviewNights = document.getElementById("bookingPreviewNights");
                                    const bookingPreviewBreakdown = document.getElementById("bookingPreviewBreakdown");
                                    const bookingPreviewTotal = document.getElementById("bookingPreviewTotal");
                                    let previewTimer;
                                    let previewRequestId = 0;

                                    const setBookingPreviewState = (state, message) => {
                                        bookingPreview.className = `booking-summary booking-summary-${state}`;
                                        bookingPreviewMessage.textContent = message;
                                        bookingPreviewDetails.hidden = state !== "available";
                                        bookingPreviewIcon.innerHTML = state === "loading"
                                            ? '<span class="booking-summary-spinner" aria-label="Loading"></span>'
                                            : `<i class="fa-regular ${state === "available" ? "fa-circle-check" : "fa-calendar"}" aria-hidden="true"></i>`;
                                    };

                                    const formatBookingCurrency = (amountPaise, currency) => new Intl.NumberFormat("en-IN", {
                                        style: "currency",
                                        currency,
                                        maximumFractionDigits: 0,
                                    }).format(amountPaise / 100);

                                    const updateBookingPreview = async () => {
                                        const checkIn = document.getElementById("checkIn").value;
                                        const checkOut = document.getElementById("checkOut").value;
                                        const guests = Number(document.getElementById("bookingGuests").value);
                                        const maxGuests = Number(document.getElementById("bookingGuests").max);
                                        const requestId = ++previewRequestId;

                                        if (!checkIn || !checkOut) {
                                            setBookingPreviewState("idle", "Select your check-in and check-out dates to see availability and estimated total.");
                                            return;
                                        }

                                        if (!Number.isInteger(guests) || guests < 1 || guests > maxGuests) {
                                            setBookingPreviewState("invalid", "Enter a valid guest count for this listing.");
                                            return;
                                        }

                                        if (checkOut <= checkIn) {
                                            setBookingPreviewState("invalid", "Check-out must be after check-in.");
                                            return;
                                        }

                                        setBookingPreviewState("loading", "Checking availability...");
                                        const params = new URLSearchParams({ checkIn, checkOut, guests });

                                        try {
                                            const response = await fetch(`${bookingForm.dataset.previewUrl}?${params}`);
                                            const result = await response.json();
                                            if (requestId !== previewRequestId) return;
                                            if (!response.ok || result.available === false) {
                                                setBookingPreviewState("unavailable", "These dates are unavailable. Please choose different dates.");
                                                return;
                                            }

                                            bookingPreviewNights.textContent = `${result.nights} night${result.nights === 1 ? "" : "s"}`;
                                            bookingPreviewBreakdown.textContent = `${formatBookingCurrency(result.pricePerNightPaise, result.currency)} × ${result.nights} night${result.nights === 1 ? "" : "s"}`;
                                            bookingPreviewTotal.textContent = formatBookingCurrency(result.totalAmountPaise, result.currency);
                                            setBookingPreviewState("available", "Your selected dates are available.");
                                        } catch (error) {
                                            if (requestId === previewRequestId) {
                                                setBookingPreviewState("error", "We couldn't check availability right now. Please try again.");
                                            }
                                        }
                                    };

                                    bookingForm.querySelectorAll("#checkIn, #checkOut, #bookingGuests").forEach((field) => {
                                        field.addEventListener("change", () => {
                                            clearTimeout(previewTimer);
                                            previewTimer = setTimeout(updateBookingPreview, 250);
                                        });
                                    });

                                    bookingForm.addEventListener("submit", (e) => {
                                        if (!bookingForm.checkValidity()) return;
                                        if (bookingForm.dataset.submitting === "true") {
                                            e.preventDefault();
                                            return;
                                        }

                                        bookingForm.dataset.submitting = "true";
                                        const submitButton = bookingForm.querySelector("[data-booking-submit]");
                                        const submitLabel = bookingForm.querySelector("[data-booking-submit-label]");
                                        const submitIcon = bookingForm.querySelector("[data-booking-submit-icon]");

                                        if (submitButton) {
                                            submitButton.disabled = true;
                                            submitButton.setAttribute("aria-busy", "true");
                                        }
                                        if (submitLabel) {
                                            submitLabel.textContent = "Sending Request...";
                                        }
                                        if (submitIcon) {
                                            submitIcon.className = "booking-submit-spinner";
                                        }
                                    });
                                </script>
                                </section>
                            <% } %>
                            <hr>
                            <% if(currentUser){ %>
                                <h4>Leave a Review</h4>
                                <form action="/listings/<%= listing._id %>/reviews" method="POST"
                                    class="needs-validation" novalidate>
                                    <div class="mb-3 mt-3">
                                        <label for="rating" class="form-label">Rating</label>
                                        <fieldset class="starability-slot">
                                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                                value="0" checked aria-label="No rating." />
                                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                            <label for="first-rate1" title="Terrible">1 star</label>
                                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                            <label for="first-rate2" title="Not good">2 stars</label>
                                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                            <label for="first-rate3" title="Average">3 stars</label>
                                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                            <label for="first-rate4" title="Very good">4 stars</label>
                                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                            <label for="first-rate5" title="Amazing">5 stars</label>
                                        </fieldset>
                                    </div>

                                    <div class="mb-3 mt-3">
                                        <label for="comments" class="form-label">Comments</label>
                                        <textarea name="review[comment]" id="comments" cols="30" rows="5"
                                            class="form-control" required></textarea>
                                        <div class="invalid-feedback">
                                            Please add some comments for review.
                                        </div>
                                    </div>

                                    <button class="btn btn-outline-dark">Submit</button>
                                </form>
                                <hr>
                                <% } %>
                                    <% if (listing.reviews.length > 0) { %>
                                        <p><b>All Reviews</b></p>

                                        <div class="row">
                                            <% for (let review of listing.reviews) { %>
                                                <div class="card col-5 mb-3 ms-3">
                                                    <div class="card-body">
                                                        <h5 class="card-title">@<%= review.author.username %>
                                                        </h5>
                                                        <p class="starability-result" data-rating="<%= review.rating %>">
                                                        </p>
                                                        <p class="card-text">
                                                            <%= review.comment %>
                                                        </p>
                                                    </div>
                                                    <form class="mb-3" method="POST"
                                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                        <button class="btn btn-sm btn-dark">Delete</button>
                                                    </form>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } %>
                        </div>
                        <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
                            <div class="listing-map-section col-8 offset-3 mt-4 mb-4">
                                <h4>Where you'll be</h4>
                                <div id="map" data-longitude="<%= listing.geometry.coordinates[0] %>"
                                    data-latitude="<%= listing.geometry.coordinates[1] %>"
                                    data-title="<%= listing.title %>"
                                    data-location="<%= listing.location %>, <%= listing.country %>"></div>
                            </div>
                        <% } %>
    </div>
